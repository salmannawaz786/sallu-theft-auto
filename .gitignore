.claude/

# working files, not part of the game
index.backup.html
music_removed/
music_original/

# generated asset pipeline outputs (large, regenerable)
pipeline/out/
pipeline/meshes/
pipeline/meshes_hq/
pipeline/__pycache__/

# third-party source models before optimisation (large).
car models thirdparty/

# NOT REDISTRIBUTABLE - must never be committed or published.
# old_car.glb is under the Sketchfab Standard licence, which forbids
# redistributing the model file at all (a public repo counts).
# grungy_little_car.glb is CC BY-NC - non-commercial only.
# Neither is used by the game; see CREDITS.txt.
models/old_car.glb
models/grungy_little_car.glb

# unused in the shipped build, kept locally only
models/car.glb
models/car_for_games_unity.glb
models/police_car.glb
models/halena_female_3_d_character.glb
models/low-poly_city_buildings.glb
models/low_poly_night_city_building_skyline.glb

# working screenshots
Screenshot*.jpg
Screenshot*.png

# your own music is yours - do not publish it
music/*/
music/*.mp3
music/*.ogg
music/*.m4a
music/*.wav
music/*.flac
music/manifest.json

# API keys. Never commit these - a key in git history is a leaked key even
# after it is deleted, because the object stays reachable.
.env
.env.*
!.env.example

# scratch: reference images, PSDs and downloads that are not game assets
Downloads/

# generation scratch - Flux outputs, background-removed PNGs and the raw
# TRELLIS car exports. meshes/car_trellis_*.glb are what the game loads;
# these are the originals they were prepared from.
cars/

# Sketchfab source models. The game loads the prepared copies in meshes/;
# shipping both doubles the download for no benefit. Rebuild with
# `node pipeline/prep_sketchfab_cars.mjs`.
2005_car_audi.glb
2018_audi_e-tron_gt_concept.glb
